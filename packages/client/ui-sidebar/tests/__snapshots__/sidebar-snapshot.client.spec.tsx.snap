// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`sidebar shell snapshots > renders the expanded column (wordmark, capsule, empty holes) 1`] = `
<div
  data-slot="sidebar"
  style="display: contents;"
>
  <div
    class="root quietBars"
    style="width: 236px;"
  >
    <div
      class="logoRow"
      data-window-drag="true"
    >
      <button
        aria-label="New task"
        class="brand wide"
        type="button"
      >
        <span
          aria-hidden="true"
          class="brandIdentity"
        >
          <span
            class="brandMark"
          >
            <div
              data-slot="sidebar.brand.mark"
              style="display: contents;"
            >
              <span
                class="copyVersion"
                data-copy-version="true"
              >
                <svg
                  aria-hidden="true"
                  data-content="655b25d2"
                  fill="none"
                  height="16.864864864864863"
                  viewBox="70 235 1110 780"
                  width="24"
                />
              </span>
            </div>
          </span>
          <span
            class="brandText"
          >
            <span
              class="brandName"
            >
              <div
                data-slot="sidebar.brand.name"
                style="display: contents;"
              >
                <span
                  class="localBuildBrand copyVersion"
                  data-copy-version="true"
                >
                  <span
                    class="localBuildTitle"
                  >
                    LingXi Office Local Build
                  </span>
                </span>
              </div>
            </span>
            <span
              class="buildVersion copyVersion"
              data-copy-version="true"
              title="1.2.3-rc.4-abc1234-dirty"
            >
              1.2.3-rc.4
            </span>
          </span>
        </span>
      </button>
    </div>
    <button
      aria-label="New task"
      class="newSession"
      type="button"
    >
      <span
        class="newSessionLabelMask"
      >
        <span
          class="newSessionContent"
        >
          <svg
            aria-hidden="true"
            data-content="6ce7f1ad"
            fill="none"
            height="17"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.6"
            viewBox="0 0 24 24"
            width="17"
          />
          <span
            class="newSessionLabel wide"
          >
            New task
          </span>
        </span>
      </span>
    </button>
    <nav
      aria-label="Global panels"
      class="panelList"
    >
      <button
        aria-label="Experts·Skills·Connectors"
        class="panelRow"
        type="button"
      >
        <span
          class="panelGlyph"
        >
          <svg
            aria-hidden="true"
            data-content="95aaaaa7"
            fill="none"
            height="17"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.6"
            viewBox="0 0 24 24"
            width="17"
          />
        </span>
        <span
          class="panelTitle wide"
        >
          Experts·Skills·Connectors
        </span>
      </button>
      <button
        aria-label="Library"
        class="panelRow"
        type="button"
      >
        <span
          class="panelGlyph"
        >
          <svg
            aria-hidden="true"
            data-content="433958a8"
            fill="none"
            height="17"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.6"
            viewBox="0 0 24 24"
            width="17"
          />
        </span>
        <span
          class="panelTitle wide"
        >
          Library
        </span>
      </button>
      <button
        aria-label="Assistant"
        class="panelRow"
        type="button"
      >
        <span
          class="panelGlyph"
        >
          <svg
            aria-hidden="true"
            data-content="8d686054"
            fill="none"
            height="17"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.6"
            viewBox="0 0 24 24"
            width="17"
          />
        </span>
        <span
          class="panelTitle wide"
        >
          Assistant
        </span>
        <span
          class="betaTag"
        >
          BETA
        </span>
      </button>
      <button
        aria-label="Projects"
        class="panelRow"
        type="button"
      >
        <span
          class="panelGlyph"
        >
          <svg
            aria-hidden="true"
            data-content="2bd58ca6"
            fill="none"
            height="17"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.6"
            viewBox="0 0 24 24"
            width="17"
          />
        </span>
        <span
          class="panelTitle wide"
        >
          Projects
        </span>
      </button>
      <button
        aria-label="More"
        class="panelRow"
        type="button"
      >
        <span
          class="panelGlyph"
        >
          <svg
            aria-hidden="true"
            data-content="abc26da5"
            fill="none"
            height="17"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.6"
            viewBox="0 0 24 24"
            width="17"
          />
        </span>
        <span
          class="panelTitle wide"
        >
          More
        </span>
      </button>
    </nav>
    <div
      class="regionArea"
    >
      <div
        data-slot="sidebar.workspaces"
        style="display: contents;"
      />
    </div>
    <div
      class="footArea"
    >
      <div
        class="footerActions"
      >
        <div
          data-slot="sidebar.footer.action"
          style="display: contents;"
        />
      </div>
      <div
        class="settingsArea"
      >
        <div
          data-slot="sidebar.settings"
          style="display: contents;"
        />
      </div>
    </div>
  </div>
</div>
`;

